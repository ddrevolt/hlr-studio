{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "crew email output: one send as module blocks with slot copy",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "brief_slug",
  "angle",
  "register",
  "subjects",
  "hero",
  "blocks",
  "cta",
  "footer"
 ],
 "properties": {
  "brief_slug": {
   "type": "string",
   "minLength": 1
  },
  "angle": {
   "type": "integer",
   "minimum": 1
  },
  "register": {
   "type": "string",
   "enum": [
    "eloquent",
    "refined",
    "sensual",
    "real",
    "uplifting"
   ]
  },
  "subjects": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "subject",
     "preview"
    ],
    "properties": {
     "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[^\\u2014]*$"
     },
     "preview": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[^\\u2014]*$"
     }
    }
   }
  },
  "hero": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "module",
    "slots"
   ],
   "properties": {
    "module": {
     "type": "string",
     "pattern": "^M(0[1-9]|1[0-9]|2[0-7])$"
    },
    "slots": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[^\\u2014]*$"
     },
     "properties": {}
    },
    "cards": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "product_id",
       "slots"
      ],
      "properties": {
       "product_id": {
        "type": "string",
        "minLength": 1
       },
       "slots": {
        "type": "object",
        "additionalProperties": {
         "type": "string",
         "pattern": "^[^\\u2014]*$"
        },
        "properties": {}
       }
      }
     }
    },
    "note": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "blocks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "module",
     "slots"
    ],
    "properties": {
     "module": {
      "type": "string",
      "pattern": "^M(0[1-9]|1[0-9]|2[0-7])$"
     },
     "slots": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "pattern": "^[^\\u2014]*$"
      },
      "properties": {}
     },
     "cards": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "product_id",
        "slots"
       ],
       "properties": {
        "product_id": {
         "type": "string",
         "minLength": 1
        },
        "slots": {
         "type": "object",
         "additionalProperties": {
          "type": "string",
          "pattern": "^[^\\u2014]*$"
         },
         "properties": {}
        }
       }
      }
     },
     "note": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "cta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "link_token"
   ],
   "properties": {
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32,
     "pattern": "^[^\\u2014a-z]*$"
    },
    "link_token": {
     "type": "string",
     "pattern": "^\\{\\{[a-z_]+\\}\\}$"
    }
   }
  },
  "footer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "module",
    "disclaimer_token",
    "legal_tokens"
   ],
   "properties": {
    "module": {
     "type": "string",
     "enum": [
      "M09",
      "M24",
      "M25"
     ]
    },
    "disclaimer_token": {
     "type": "string",
     "const": "{{footer_disclaimer}}"
    },
    "legal_tokens": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^\\{\\{[a-z_]+\\}\\}$"
     }
    }
   }
  }
 }
}
