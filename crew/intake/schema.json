{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "crew intake output: the structured brief",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slug",
  "brand",
  "source",
  "objective",
  "audience",
  "message",
  "moment",
  "offer",
  "products",
  "channels",
  "must_say",
  "guidance",
  "never_say",
  "gaps"
 ],
 "properties": {
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "brand": {
   "type": "string",
   "const": "High Light Rituals"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "received_at"
   ],
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[^\\u2014]*$"
    },
    "received_at": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "objective": {
   "type": "string",
   "minLength": 1,
   "pattern": "^[^\\u2014]*$"
  },
  "audience": {
   "type": "string",
   "minLength": 1,
   "pattern": "^[^\\u2014]*$"
  },
  "message": {
   "type": "string",
   "minLength": 1,
   "pattern": "^[^\\u2014]*$"
  },
  "moment": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[^\\u2014]*$"
  },
  "offer": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "text",
    "code_token",
    "figures_as_tokens"
   ],
   "properties": {
    "text": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[^\\u2014]*$"
    },
    "code_token": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^\\{\\{[a-z_]+\\}\\}$"
    },
    "figures_as_tokens": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^\\{\\{[a-z_]+\\}\\}$"
     }
    }
   }
  },
  "products": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "role",
     "resolved",
     "facts"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     },
     "role": {
      "type": "string",
      "enum": [
       "hero",
       "lineup",
       "closing"
      ]
     },
     "resolved": {
      "type": "boolean"
     },
     "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "category",
       "family",
       "ingredients",
       "source"
      ],
      "properties": {
       "category": {
        "type": [
         "string",
         "null"
        ]
       },
       "family": {
        "type": [
         "string",
         "null"
        ]
       },
       "ingredients": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "source": {
        "type": "string",
        "const": "brand-pack/products.json"
       }
      }
     }
    }
   }
  },
  "channels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "enum": [
     "email",
     "paid"
    ]
   }
  },
  "must_say": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "pattern": "^[^\\u2014]*$"
   }
  },
  "guidance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "vocabulary",
    "tone",
    "notes"
   ],
   "properties": {
    "vocabulary": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     }
    },
    "tone": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     }
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     }
    }
   }
  },
  "never_say": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "gaps": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "field",
     "note",
     "owner"
    ],
    "properties": {
     "field": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     },
     "note": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     },
     "owner": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
