{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "crew strategist output: three angles for a human to pick from",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "brief_slug",
  "angles"
 ],
 "properties": {
  "brief_slug": {
   "type": "string",
   "minLength": 1
  },
  "angles": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "n",
     "axis",
     "register",
     "lead_line",
     "opening_module",
     "exemplar_ref",
     "rationale"
    ],
    "properties": {
     "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "axis": {
      "type": "string",
      "enum": [
       "benefit",
       "occasion",
       "product",
       "proof",
       "urgency",
       "curiosity"
      ]
     },
     "register": {
      "type": "string",
      "enum": [
       "eloquent",
       "refined",
       "sensual",
       "real",
       "uplifting"
      ]
     },
     "lead_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[^\\u2014]*$"
     },
     "opening_module": {
      "type": "string",
      "pattern": "^M(0[1-9]|1[0-9]|2[0-7])$"
     },
     "exemplar_ref": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^hlr-"
     },
     "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u2014]*$"
     }
    }
   }
  }
 }
}
