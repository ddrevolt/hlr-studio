{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "studio-engine/options-board/packet-schema.json",
  "title": "Route packet",
  "description": "The unit a route worker returns and the verifier reads: one route's complete execution, compact enough to pass between agents (paths and verdicts, not transcripts). Written by squad-run (Phase 2), scored by verify (Phase 2), rendered by render_board.js (now). Nothing here is a transcript; nothing here is a rank the board invented.",
  "type": "object",
  "required": [
    "kind",
    "format",
    "route_id",
    "frame",
    "angle",
    "brief_ref",
    "brand",
    "channel_deliverables",
    "passed_over",
    "provenance",
    "verifier",
    "completion"
  ],
  "properties": {
    "kind": {
      "const": "route-packet"
    },
    "format": {
      "const": 1
    },
    "route_id": {
      "type": "string",
      "pattern": "^R[0-9]+$"
    },
    "frame": {
      "type": "string",
      "minLength": 1,
      "description": "the strategic axis this route leads, from the route plan"
    },
    "angle": {
      "type": "string",
      "minLength": 1,
      "description": "the one-line angle from the route plan"
    },
    "brief_ref": {
      "type": "string",
      "minLength": 1,
      "description": "path to the <slug>.brief.json this route executes"
    },
    "routes_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "path to the <slug>.routes.json"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "worker": {
      "type": [
        "object",
        "null"
      ],
      "description": "who produced the packet; null until squad-run exists",
      "properties": {
        "skill": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "channel_deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/deliverable"
      }
    },
    "passed_over": {
      "type": "array",
      "description": "options the worker considered and dropped, with a reason from the options register's closed set, so the board shows what was passed over and nobody re-litigates it",
      "items": {
        "type": "object",
        "required": [
          "option",
          "reason"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "email",
              "paid",
              "web",
              "social",
              "video",
              null
            ]
          },
          "gate": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "enum": [
              "occasion",
              "weaker",
              "off-brief",
              "duplicate",
              "blocked"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "brand",
        "brand_context",
        "cost"
      ],
      "properties": {
        "brand": {
          "type": "string"
        },
        "brand_context": {
          "type": "string"
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "model",
            "input_tokens",
            "output_tokens",
            "media_calls",
            "measured_by"
          ],
          "properties": {
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ]
            },
            "media_calls": {
              "type": [
                "integer",
                "null"
              ]
            },
            "measured_by": {
              "type": "string"
            }
          }
        }
      }
    },
    "verifier": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "scores",
            "rank",
            "unknown"
          ],
          "description": "filled by the verifier (Phase 2), never by the worker and never by the board",
          "properties": {
            "scores": {
              "type": "object",
              "description": "one entry per dimension: brief_adherence, voice_fit, visual_legibility, pack_fidelity, ... each scored in isolation",
              "additionalProperties": true
            },
            "rank": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "unknown": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "dimensions the verifier could not judge (no render, no exemplars); listed, never scored"
            },
            "verified_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "independent": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "true when the verifier ran in a fresh context that never saw the worker's transcript"
            }
          }
        }
      ]
    },
    "completion": {
      "type": "object",
      "required": [
        "brief_type",
        "items",
        "complete",
        "verdict"
      ],
      "description": "the completion contract for the brief type, item by item. The board recomputes it from the deliverables and the render files and never trusts `complete` alone: a placeholder render or a missing mobile makes the route INSUFFICIENT-INPUT, never PASS.",
      "properties": {
        "brief_type": {
          "enum": [
            "email",
            "paid_static",
            "web",
            "social",
            "video"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "item",
              "done"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "done": {
                "type": "boolean"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the path or report that proves it"
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "PASS",
            "INSUFFICIENT-INPUT"
          ]
        }
      }
    }
  },
  "definitions": {
    "score": {
      "type": "object",
      "required": [
        "score",
        "pass",
        "note"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pass": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "render": {
      "type": "object",
      "required": [
        "surface",
        "ratio_or_breakpoint",
        "path",
        "rendered_by"
      ],
      "properties": {
        "surface": {
          "enum": [
            "email",
            "paid",
            "web",
            "social",
            "video"
          ]
        },
        "ratio_or_breakpoint": {
          "type": [
            "string",
            "integer"
          ],
          "description": "4x5, 1x1, 9x16 for paid, social and video; 1440 or 390 for web and email masters; 'email' for a single email render"
        },
        "item": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "social carousel or story set: the panel or frame this render shows, 1-based; one render per panel or frame at each ratio"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "the render file (png, jpg, webp, svg, mp4). null means not rendered, and the board says so"
        },
        "rendered_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "figma-screenshot, playwright, figma-export, image-model, placeholder"
        },
        "placeholder": {
          "type": "boolean",
          "description": "true when the file is a stand-in (a grey box, a draft-tier image marked as such); a placeholder never counts as rendered"
        }
      }
    },
    "image_plan": {
      "type": "object",
      "required": [
        "scene",
        "pack_composite",
        "focal_point",
        "crops"
      ],
      "properties": {
        "scene": {
          "type": [
            "string",
            "null"
          ]
        },
        "pack_composite": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "sku": {
              "type": [
                "string",
                "null"
              ]
            },
            "file": {
              "type": [
                "string",
                "null"
              ],
              "description": "the approved pack shot from the pack's pack_shot_index; never generated"
            }
          }
        },
        "focal_point": {
          "type": [
            "string",
            "null"
          ]
        },
        "crops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ratio_or_breakpoint": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "crop": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "enum": [
            "sourced",
            "shot",
            "generated",
            null
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deliverable": {
      "type": "object",
      "required": [
        "surface",
        "copy",
        "lint",
        "renders",
        "image_plan",
        "image_files"
      ],
      "properties": {
        "surface": {
          "enum": [
            "email",
            "paid",
            "web",
            "social",
            "video"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "the deliverable name from the brief"
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "content type, ad type or page type"
        },
        "copy": {
          "type": "object",
          "required": [
            "path",
            "skill"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ],
              "description": "the copy skill's JSON output: <slug>.slates.json, <slug>.paid.json, <slug>.page.json, <slug>.social.json"
            },
            "skill": {
              "enum": [
                "email-copy",
                "paid-ad-copy",
                "web-copy",
                "social-copy",
                null
              ]
            }
          }
        },
        "lint": {
          "type": "object",
          "required": [
            "path",
            "verdict"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verdict": {
              "enum": [
                "PASS",
                "WARN",
                "FAIL",
                "INSUFFICIENT-INPUT",
                null
              ]
            }
          }
        },
        "a11y": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verdict": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "safe_zone": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verdict": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "fit_check": {
          "type": [
            "object",
            "null"
          ],
          "description": "0.3.0: scripts/fit_check.js report for the deliverable's composed-to-cut pass",
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verdict": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "voice_lint": {
          "type": [
            "object",
            "null"
          ],
          "description": "0.3.0: scripts/voice_lint.js advisory report; never a blocker, records which pack model version scored it",
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verdict": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_weak": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "mean_likelihood": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "figma": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "file_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "node_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "agent_package": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "renders": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/render"
          }
        },
        "image_plan": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/image_plan"
            }
          ]
        },
        "image_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
